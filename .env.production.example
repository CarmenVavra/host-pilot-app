# HostPilot – Vorlage für die .env auf dem Server (netcup).
# Kopieren nach ".env" auf dem Server und die Werte mit <…> ersetzen.
# Diese Datei enthält keine Geheimnisse und darf im Repository bleiben.

APP_NAME=HostPilot
APP_ENV=production
APP_DEBUG=false
# Wird mit "php artisan key:generate --force" auf dem Server erzeugt (nie den lokalen Key verwenden)
APP_KEY=
APP_URL=https://<deine-domain.at>

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Datenbank (MySQL/MariaDB aus dem netcup-Paket) ---
DB_CONNECTION=mysql
DB_HOST=<db-host-aus-dem-CCP>
DB_PORT=3306
DB_DATABASE=<datenbankname>
DB_USERNAME=<benutzer>
DB_PASSWORD=<passwort>

# --- Sitzungen: nur über HTTPS ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Auf Shared Hosting läuft kein Queue-Worker: Jobs sofort ausführen
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# --- E-Mail (Passwort zurücksetzen) – Postfach beim Hoster ---
MAIL_MAILER=smtp
MAIL_HOST=<smtp-server-des-hosters>
MAIL_PORT=587
MAIL_USERNAME=<postfach@deine-domain.at>
MAIL_PASSWORD=<postfach-passwort>
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=<postfach@deine-domain.at>
MAIL_FROM_NAME="${APP_NAME}"

# --- Impressum & Datenschutz (Pflichtangaben, sonst erscheinen Platzhalter) ---
LEGAL_COUNTRY=AT
LEGAL_NAME="<Vor- und Nachname>"
LEGAL_STREET="<Strasse Hausnummer>"
LEGAL_CITY="<PLZ Ort>"
LEGAL_EMAIL=<kontakt@deine-domain.at>
# LEGAL_PHONE=
# LEGAL_VAT_ID=
